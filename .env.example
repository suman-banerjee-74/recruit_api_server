# This application's own settings. It never reads the parent project's .env.
FUSION_BASE_URL=https://your-instance.example.com
FUSION_API_VERSION=11.13.18.05
FUSION_USERNAME=replace-with-oracle-service-user
FUSION_PASSWORD=replace-with-oracle-service-password
RECRUIT_API_PORT=8010
FUSION_TIMEOUT=40
FUSION_MAX_RETRIES=2
FUSION_MAX_BACKOFF=10
FUSION_MAX_PAGES=1000
FUSION_MAX_ITEMS=100000
FUSION_PAGE_SIZE=200
FUSION_MAX_JSON_BYTES=10485760
FUSION_MAX_RESULT_BYTES=52428800
FUSION_MAX_RESUME_BYTES=20971520
FUSION_MAX_ARCHIVE_BYTES=104857600
FUSION_MAX_TEXT_BYTES=5242880
RECRUIT_CACHE_TTL=60
RECRUIT_CACHE_ENTRIES=256
RECRUIT_CACHE_BYTES=20971520
# The sole Oracle write operation is the explicitly requested application move.
FUSION_ENABLE_JOURNEY_UPDATES=false
